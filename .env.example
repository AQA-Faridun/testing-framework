# Copy to .env and adjust. Every value has a default, so .env is optional.

# Stand under test
STAND_NAME=local
API_BASE_URL=http://localhost
WEB_BASE_URL=http://localhost

# Timeouts
API_TIMEOUT_S=60
UI_TIMEOUT_MS=15000

# Web artifacts attached to Allure (screenshot, HTML, trace, HAR, console): "on-failure" or "always"
WEB_ARTIFACTS=on-failure
